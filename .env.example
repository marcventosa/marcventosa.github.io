# Copy this file to .env and fill in your key. .env is gitignored — never commit it.
# DeepL free API key (500k chars/month): https://www.deepl.com/pro-api
DEEPL_API_KEY=

# Optional: LibreTranslate base URL if you self-host it (docker compose up -d)
# LIBRE_URL=http://localhost:5000

# Optional tuning
# TRANSLATE_DELAY=1200
# TRANSLATE_RETRIES=3